# Production environment for docker-compose.prod.yml.
# Copy to .env.prod on the server, fill in real values, chmod 600.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Generate secrets with: openssl rand -base64 32

# ── Domain / base URL ────────────────────────────────────────────────────────
# Bare domain, used by certbot/deploy scripts.
DOMAIN=exam.example.com

# Bare domain nginx accepts as its Host. REQUIRED: nginx refuses to start
# without it, and any request carrying a different Host header is answered
# with 444 instead of reaching the app (host-header poisoning defense —
# better-auth builds verification/reset links from the request origin, so an
# attacker-supplied Host would redirect those emails to an attacker server).
OPENEXAM_DOMAIN=exam.example.com

# Public origin. Baked into the client bundle at image build time — rebuild the
# web image whenever this changes. The ws-backend reads this same variable
# (APP_BASE_URL remains as a legacy fallback) or SEB Config Key verification
# silently breaks.
NEXT_PUBLIC_BASE_URL=https://exam.example.com

# Better Auth server URL — same value as NEXT_PUBLIC_BASE_URL. REQUIRED in
# production (the app refuses to start without it): better-auth builds email
# verification/reset links and derives trusted origins from this pinned value
# instead of the request's Host header.
BETTER_AUTH_URL=https://exam.example.com

# Where Let's Encrypt sends certificate expiry warnings (scripts/issue-cert.sh).
# Defaults to admin@DOMAIN when empty.
ACME_EMAIL=

# Comma-separated allowed origins for API/WS CSRF checks.
ALLOWED_ORIGINS=https://exam.example.com

# Optional: comma-separated SEB "Allowed SEB Versions" restrictions on clients
# that support the setting, e.g. "Mac.3.7.1.min,Win.3.10.2.min".
# Current SEB clients restrict only the platforms named in the list; omitted
# platforms remain unrestricted. Older clients may ignore the setting entirely,
# so this is defense in depth, not server-side client attestation.
# Leave unset (SEB's default) until you've qualified the required client versions.
# Changing this list changes Config Keys: regenerate frozen keys and have
# students download fresh configs. See lib/SEB_OUT_OF_SCOPE.md.
# SEB_ALLOWED_VERSIONS=Mac.3.7.1.min,Win.3.10.2.min

# NEXT_PUBLIC_WS_URL is intentionally NOT set in production: the browser falls
# back to the page origin and nginx proxies /ws/ to the Go backend same-origin.

# ── Exam-start admission queue (lib/exam-admission.ts) ──────────────────────
# A class starting an exam all presses "Teilnehmen" at once, and that single
# burst is the heaviest traffic this app ever sees. New joiners are let in at
# a fixed rate instead; anyone held back waits in a countdown on the join
# form, and their exam clock does not start until they are admitted.
#
# Both are optional — leave them unset for the defaults below, which suit a
# class-sized cohort. Resumes (a student reconnecting to an exam already in
# progress) always skip the queue, as does the first second's worth of any
# cohort — at the default rate a class of 25 never sees it at all.
#
# How many first-time joins are admitted per second (default 25).
# EXAM_ADMISSION_RATE_PER_SEC=25
# Longest any one student waits, in seconds (default 45). 0 turns the queue
# off entirely and restores the unthrottled behaviour.
# EXAM_ADMISSION_MAX_WAIT_SEC=45

# ── Secrets ──────────────────────────────────────────────────────────────────
# All of the below are placeholder values on purpose — the app refuses to
# start in production with a placeholder or a too-short secret, so filling
# every one in with a real value is mandatory, not optional.
# Generate secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
POSTGRES_PASSWORD=change-me
# HMAC key for anonymized matching IDs (lib/exam-session.ts). Min 32 chars.
MATCHING_ID_SECRET=change-me
# Code teachers must enter when self-registering. Min 12 chars.
TEACHER_ACCESS_CODE=change-me
# AES-256-GCM key for at-rest encryption (OAuth tokens, SEB quit passwords) —
# lib/at-rest-encryption.ts. Min 32 chars; REQUIRED in production. Rotating
# it invalidates stored encrypted values (re-run scripts/encrypt-at-rest.ts
# after rotation to re-wrap).
AT_REST_ENC_KEY=change-me

# ── Microsoft 365 (Entra ID) login ───────────────────────────────────────────
# Optional in production: leave all three empty and Microsoft login is
# disabled entirely. Setting ANY of them opts in — and then the tenant MUST
# be a GUID (not "common"), enforced at boot (lib/env.ts / lib/auth.ts).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant GUID (not "common") to restrict login to the school tenant.
MICROSOFT_TENANT_ID=
# School email domains, comma-separated (lib/school-domains.ts). Addresses on
# a student domain sign up as students, on a teacher domain as teachers.
# Microsoft logins with any other address are rejected, so at least one is
# required once Microsoft login is configured. Example:
#   SCHOOL_STUDENT_DOMAINS=stud.example-school.ch
#   SCHOOL_TEACHER_DOMAINS=example-school.ch
SCHOOL_STUDENT_DOMAINS=
SCHOOL_TEACHER_DOMAINS=

# ── SMTP (email verification / notifications, lib/email.ts) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OpenExam <no-reply@exam.example.com>"

# ── Cap (self-hosted CAPTCHA, trycap.dev) ────────────────────────────────────
# Dashboard-login password for the cap service. Min 16 chars, enforced at boot.
# Never given to the web tier (docker-compose.prod.yml no longer loads the
# whole env file there); the dashboard itself is unreachable through nginx,
# which only proxies site-key-shaped paths under /cap-api/.
CAP_ADMIN_KEY=change-me
# Created automatically by scripts/create-cap-site-key.sh (cap admin API,
# no dashboard/SSH-tunnel needed) after the first deploy; it rewrites this
# placeholder plus NEXT_PUBLIC_CAP_WIDGET_ENDPOINT below.
CAP_SECRET_KEY=sk-change-me
# Full widget endpoint (site key baked in — it's public, unlike the secret
# key above). The PoW challenge runs in the student's browser, so this must
# be reachable from the internet, not just the Docker network. The path is
# relative to the app origin: nginx proxies /cap-api/ to the cap service in
# prod (nginx/nginx.conf), and next.config.mjs rewrites it to CAP_ORIGIN in
# every other deployment (dev server, standalone build). Baked into the
# client bundle at build time like NEXT_PUBLIC_BASE_URL — rebuild the web
# image whenever it changes.
NEXT_PUBLIC_CAP_WIDGET_ENDPOINT=/cap-api/change-me/
# Where the cap service actually lives. Defaults to http://localhost:8090
# (docker-compose.yml dev). Prod sets the internal Docker network URL via a
# Dockerfile build arg (docker-compose.prod.yml passes http://cap:3000) — the
# rewrite is baked into the standalone build at build time.
CAP_ORIGIN=http://localhost:8090
# Internal Docker network address — docker-compose.prod.yml sets this
# automatically; only needed here for docker-compose.yml (dev).
CAP_SITEVERIFY_URL=http://localhost:8090/siteverify

# ── Datenschutzerklärung & Impressum (/datenschutz, /impressum) ──────────────
# The school running this deployment is the data controller, so these name
# it on the public legal pages (lib/legal/config.ts). The first four are
# required in production — the app refuses to boot with them empty (left
# empty here, not change-me, so the dev server still starts: development
# falls back to "Beispielschule" placeholders).
# The template is a starting point, not legal advice: have the school's data
# protection officer review the rendered pages before going live.
LEGAL_CONTROLLER_NAME=
# Use \n between lines, e.g. "Musterstrasse 1\n8000 Zürich".
LEGAL_CONTROLLER_ADDRESS=
LEGAL_CONTACT_EMAIL=
# Where the server runs, e.g. "Hetzner Online GmbH, Rechenzentrum Falkenstein (DE)".
LEGAL_HOSTING_PROVIDER=
# Optional:
LEGAL_CONTACT_PHONE=
# Data protection officer (Datenschutzbeauftragte/r), if the school has one.
LEGAL_DPO_NAME=
LEGAL_DPO_EMAIL=
# Person responsible for content (Impressum).
LEGAL_IMPRESSUM_RESPONSIBLE=
# Replaces the default retention paragraph with the school's actual rules.
LEGAL_RETENTION_NOTE=
# With WALG_STORAGE_BACKEND=sftp, /datenschutz discloses the encrypted off-site
# backups; this names the backup host's operator there, e.g. "Hetzner Storage Box (DE)".
LEGAL_BACKUP_PROVIDER=
# Shown as "Stand" and stored with each account's acknowledgement. Set a new
# date whenever you change the wording above; empty uses the template's date.
LEGAL_POLICY_VERSION=

# ── Monitoring & alerting (opt-in: scripts/setup-monitoring.sh) ─────────────
# Nothing below this section is required to run OpenExam — the monitoring
# stack (Prometheus/Grafana/Alertmanager/GlitchTip + PITR backups) is
# entirely optional and only comes up if you run setup-monitoring.sh. See
# DEPLOYMENT.md's "Monitoring & Alerting" and "Point-in-time recovery"
# sections before filling these in.

# Grafana admin login (dashboards reachable only via `ssh -L 3001:localhost:3001`).
GRAFANA_ADMIN_PASSWORD=change-me

# GlitchTip (self-hosted, Sentry-protocol-compatible error tracker). Shares
# the existing postgres/redis services — monitoring-db-init creates the
# `glitchtip` database and role. SECRET_KEY signs GlitchTip's own sessions;
# generate with: openssl rand -base64 48
GLITCHTIP_SECRET_KEY=change-me
GLITCHTIP_DB_PASSWORD=change-me

# Least-privilege Postgres role for postgres-exporter (pg_monitor grant,
# read-only) — created by monitoring-db-init alongside the glitchtip role.
MONITORING_DB_PASSWORD=change-me

# Server-side + client-bundle DSN for GlitchTip capture (instrumentation.ts /
# instrumentation-client.ts). Points at the internal glitchtip-web address —
# safe to be identical and "public" in the client bundle, since browser
# events are relayed through app/api/monitoring/tunnel, never sent to this
# host directly. Format: http://glitchtip-web:8000/<project-id>
# Get the project ID from the GlitchTip UI (ssh -L 8001:localhost:8001) after
# first creating a project there — leave both empty to disable error capture.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Where Alertmanager sends infra alert emails (container down, disk >85%,
# backup failures, cert expiry, elevated 5xx rate) — rendered into
# monitoring/alertmanager/alertmanager.yml from the SMTP_* values above.
ALERT_EMAIL_TO=

# Local-only opt-outs (both refused when NODE_ENV=production — see
# lib/rate-limit.ts / lib/auth.ts / lib/cap.ts). DISABLE_RATE_LIMIT skips the
# Redis-backed rate limiter for k6/Playwright stress iteration (load/README.md).
# DISABLE_CAPTCHA is separate on purpose: e2e/toctou-fixes.spec.ts needs rate
# limiting ON but captcha OFF to test the limiter itself, so one flag can't
# cover both.
DISABLE_RATE_LIMIT=
DISABLE_CAPTCHA=

# Optional encrypted SFTP backups: disabled (default) or sftp.
# Disabled stops WAL archiving and scheduled PITR; daily pg_dump continues.
WALG_STORAGE_BACKEND=disabled
WALG_SSH_HOST=
WALG_SSH_PORT=22
WALG_SSH_USER=walg
WALG_SSH_PATH=/archive

# Finalize disconnected/locked sessions 5 minutes after their effective deadline.
# Set false to disable the server-side recovery timer (persistent Node runtime).
DEADLINE_SWEEPER_ENABLED=true
# Prune superseded answer attachments of settled, submitted sessions every 10
# minutes (see DEPLOYMENT.md "Attachment storage and retention").
ANSWER_FILE_RETENTION_ENABLED=true
