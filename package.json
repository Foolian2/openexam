{
  "name": "openexam",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "next experimental-analyze",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "seb:sync-defaults": "tsx scripts/sync-seb-defaults.ts",
    "seb:regenerate-keys": "tsx --env-file-if-exists=.env scripts/regenerate-seb-config-keys.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:stress": "playwright test --config=playwright.stress.config.ts",
    "load:seed": "tsx --env-file-if-exists=.env scripts/load-seed.ts",
    "load:smoke": "k6 run load/scenarios/01-rest-smoke.js",
    "load:join": "k6 run load/scenarios/02-join-and-autosave.js",
    "load:ws-connect": "k6 run load/scenarios/03-ws-mass-connect.js",
    "load:ws-latency": "k6 run load/scenarios/04-ws-answer-latency.js",
    "load:mixed": "k6 run load/scenarios/05-mixed-exam-room.js",
    "load:classroom": "k6 run load/scenarios/06-classroom-ladder.js",
    "load:submit": "k6 run load/scenarios/07-mass-submit.js",
    "load:fanout": "k6 run load/scenarios/08-monitor-fanout.js",
    "load:integrity": "k6 run load/scenarios/09-integrity-load.js",
    "load:soak": "k6 run load/scenarios/10-soak.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/passkey": "1.7.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.4.0",
    "@swc/helpers": "^0.5.23",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.50.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "nuqs": "^2.10.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "plist": "^3.1.0",
    "prom-client": "^15.1.3",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "sanitize-html": "^2.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/plist": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^20.14.5",
    "jose": "^6.2.12",
    "pino-pretty": "^13.1.3",
    "postcss": "^8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
